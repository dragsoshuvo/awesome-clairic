// 301s www.awesomeclairic.com/* to the canonical https://awesomeclairic.com/*.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "awesomeclairic-www",
  "main": "index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "routes": [{ "pattern": "www.awesomeclairic.com", "custom_domain": true }]
}
